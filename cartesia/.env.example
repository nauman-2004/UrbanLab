# UrbanLab Cartesia voice-research module: TEMPLATE ONLY (placeholders, no real values).
#
# Put real values in the repo-root .env (shared UrbanLab convention) or in cartesia/.env.local.
# Both are git-ignored. Never commit them and never paste them into chats.
#
# SECURITY: every variable below is SERVER-SIDE ONLY.
# Never create NEXT_PUBLIC_CARTESIA_* versions; NEXT_PUBLIC_* values are bundled into the browser.

# "mock" (default): deterministic scripted session, no network, no microphone, no key needed.
# "live": real Cartesia voice agent session in the browser (needs the two values below).
CARTESIA_DEMO_MODE=mock

# Cartesia API key (https://play.cartesia.ai -> API keys). Used only by the server route
# /api/cartesia/session to mint a short-lived, single-use session token.
CARTESIA_API_KEY=

# ID of a voice agent you created in the Cartesia dashboard (Agents).
# UrbanLab overrides its instructions and first message per study, server-side.
CARTESIA_AGENT_ID=

# Optional: override the Cartesia API version header (default 2026-08-14).
# CARTESIA_API_VERSION=2026-08-14
