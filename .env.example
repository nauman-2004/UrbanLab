# UrbanLab environment variables — TEMPLATE ONLY.
# Copy to `.env` in the repo root and fill it in on your own machine:   cp .env.example .env
# `.env` is git-ignored; never commit it, paste it into chats, or expose secrets through NEXT_PUBLIC_* variables
# (those are bundled into the browser). "replace-me" and "/absolute/path/to/..." are treated as "not set".
# Every component (frontend, agent backend, costar/ adapters) reads this one root file.

# ---- Frontend (Next.js) ----
# frontend/next.config.ts loads this file; frontend/.env.local overrides it. `npm run dev` sets both for you.
# Data source for the UI: "replay" (plays a recorded backend run, no backend needed) or "live" (talks to the backend)
NEXT_PUBLIC_STUDY_SOURCE=replay
# Base URL of the agent backend, used when NEXT_PUBLIC_STUDY_SOURCE=live
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- Agent backend (LangChain Deep Agents) ----
# OpenRouter API key (https://openrouter.ai/settings/keys). Required for live runs.
# Free models allow 50 requests/day; buying $10 of credits once raises that to 1000/day.
OPENROUTER_API_KEY=

# LangChain "provider:model" ids. Defaults shown (both free on OpenRouter).
# Agent (orchestrator + subagents): needs tool calling.
URBANLAB_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Aerial-tile vision + transcript extraction: needs image input and structured output.
URBANLAB_VISION_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free
URBANLAB_EXTRACTION_MODEL=openrouter:nvidia/nemotron-3.5-super-vl:free

# Where the agent gets CoStar property records:
#   auto      the CoStar kit if COSTAR_KIT_ZIP is set below, otherwise the sample CSV (default)
#   kit       the CoStar kit only (a study fails clearly if it isn't configured)
#   synthetic the costar/ package's invented test kit (no sponsor data; for development)
#   sample    backend/data/costar_sample.csv
URBANLAB_COSTAR_SOURCE=auto
# The property sample is a seeded random draw from every match, so it isn't biased toward low ids.
URBANLAB_SAMPLE_SEED=0

# Demo mode: cache CoStar + vision outputs on the first run, replay them in ~DEMO_REPLAY_SECONDS afterwards
DEMO_MODE=1
DEMO_REPLAY_SECONDS=20

# Max phone surveys per study, and default number of properties to sample
SURVEY_MAX_CALLS=3
DEFAULT_SAMPLE_N=8

# Comma-separated origins allowed to call the backend
CORS_ORIGINS=http://localhost:3000

# Data paths (relative to backend/). Defaults shown.
# COSTAR_SAMPLE_CSV=data/costar_sample.csv
# VEXCEL_TILES_DIR=data/tiles
# URBANLAB_CACHE_DIR=data/cache
# URBANLAB_DATASET_JSON=data/dataset.json

# ---------------------------------------------------------------------------
# CoStar data kit (a local, password-protected zip; there is no CoStar API). See costar/README.md.
# ---------------------------------------------------------------------------
# Absolute path to the kit zip you downloaded from the CoStar keys card.
COSTAR_KIT_ZIP=/absolute/path/to/costar-kit.zip
COSTAR_ZIP_PASSWORD=replace-me
# The kit's download link (informational only; UrbanLab never downloads it).
COSTAR_KIT_URL=
# Optional: path to the local, git-ignored field map. Default: costar/.local/field_map.toml
COSTAR_FIELD_MAP=

# ---------------------------------------------------------------------------
# Matterport
# ---------------------------------------------------------------------------
# Model API (server-side only; HTTP basic auth: key = user, token = password).
MATTERPORT_API_KEY=replace-me
MATTERPORT_API_TOKEN=replace-me
# Absolute path to the sponsor's models_index.csv (kept outside git).
MATTERPORT_INDEX_CSV=/absolute/path/to/models_index.csv
# Embed SDK key + its allowed domains. Not used by the backend adapter.
# Do NOT put it in NEXT_PUBLIC_*; see costar/README.md ("Matterport embed").
MATTERPORT_SDK_KEY=replace-me
MATTERPORT_SDK_ALLOWED_DOMAINS=localhost

# ---------------------------------------------------------------------------
# Vexcel (server-side only; sent as the X-API-KEY header)
# ---------------------------------------------------------------------------
VEXCEL_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Safety switches. Authenticated calls stay OFF unless ALL of these allow it:
#   URBANLAB_LIVE_MODE=1, <PROVIDER>_LIVE=1 and <PROVIDER>_MAX_REQUESTS_PER_RUN > 0
# ---------------------------------------------------------------------------
URBANLAB_LIVE_MODE=0
VEXCEL_LIVE=0
MATTERPORT_LIVE=0
VEXCEL_MAX_REQUESTS_PER_RUN=0
MATTERPORT_MAX_REQUESTS_PER_RUN=0
# Requests per second (capped at 5; the sponsor asks for well under 10/s).
VEXCEL_MAX_RPS=1
MATTERPORT_MAX_RPS=1
URBANLAB_HTTP_TIMEOUT_S=60
# Retries on 429/5xx (capped at 3).
URBANLAB_MAX_RETRIES=2
# Hard cap on properties per study run.
URBANLAB_MAX_PROPERTIES=25
# Where sponsor-derived local files live. Default: costar/.local/ (git-ignored).
URBANLAB_SPONSOR_DATA_DIR=

# ---- Not used yet (the phone survey is a stub) ----
# Add these once a real client replaces the stub in backend/telephony.py.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# CARTESIA_API_KEY=
